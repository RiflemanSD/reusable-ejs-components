<%#
  next-move-badge.ejs — μικρό badge «📌 επόμενη κίνηση» για γραμμές λιστών.

  Props:
    row  (object) γραμμή με τα πεδία του `workflowService.attachStatuses`:
                  our_next_move, our_next_move_short, our_next_move_bucket
    size (string) 'xs' (default) | 'sm'

  Τίποτα δεν βγαίνει αν η γραμμή δεν έχει κίνηση ή ημερομηνία.
%>
<%
  const _nmRow = (typeof row !== 'undefined' && row) ? row : {};
  const _nmText = _nmRow.our_next_move || '';
  const _nmShort = _nmRow.our_next_move_short || '';
  const _nmBucket = _nmRow.our_next_move_bucket || '';
  const _nmTone = { overdue: 'badge-error', today: 'badge-warning', week: 'badge-info', later: 'badge-success' }[_nmBucket] || 'badge-ghost';
  const _nmEmoji = { overdue: '🔴', today: '🟠', week: '🟡', later: '🟢' }[_nmBucket] || '📌';
  const _nmSize = (typeof size !== 'undefined' && size === 'sm') ? 'badge-sm' : 'badge-xs';
%>
<% if (_nmText || _nmShort) { %>
<span class="badge <%= _nmSize %> <%= _nmTone %> gap-1 max-w-56 truncate" title="📌 Επόμενη κίνηση: <%= _nmText || '—' %><%= _nmShort ? ' · ' + _nmShort : '' %>">
  <%= _nmEmoji %> <%= _nmShort ? _nmShort + (_nmText ? ' · ' : '') : '' %><%= _nmText %>
</span>
<% } %>
